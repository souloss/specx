{
  "info": {
    "title": "specX API",
    "version": "1.0.0"
  },
  "servers": ["/api/specx"],
  "operations": {
    "/access": {"get": ["200", "403"]},
    "/backups": {"get": ["200", "403"], "post": ["200", "403", "500"]},
    "/backups/{file_name}/restore": {"post": ["200", "400", "403", "404"]},
    "/catalog": {"get": ["200", "401", "403", "429", "500"]},
    "/code-bindings/{binding_id}": {"delete": ["204"], "put": ["200"]},
    "/code-sources": {"get": ["200"], "post": ["200"]},
    "/code-sources/{source_id}": {"delete": ["204"], "put": ["200"]},
    "/groups": {"get": ["200", "400", "401", "403", "429"], "post": ["200", "400", "401", "403", "409", "413", "415", "422", "429", "500"]},
    "/groups/order": {"put": ["200", "400", "401", "403", "413", "415", "422"]},
    "/groups/{group_id}": {"delete": ["204", "400", "401", "403", "404", "409"], "put": ["200", "400", "401", "403", "404", "409", "413", "415", "422"]},
    "/health": {"get": ["200"]},
    "/invitations": {"get": ["200", "403"], "post": ["201", "400", "403", "413", "415", "422"]},
    "/invitations/{invitation_id}": {"delete": ["204", "400", "401", "403", "404"]},
    "/invitations/accept": {"post": ["200", "400", "404", "413", "415", "422"]},
    "/metrics": {"get": ["200"]},
    "/members": {"get": ["200", "400", "401", "403", "429"]},
    "/members/{member_actor_id}": {"delete": ["204", "400", "401", "403", "404", "409"], "put": ["200", "400", "401", "403", "409", "413", "415", "422"]},
    "/ready": {"get": ["200", "503"]},
    "/services": {"get": ["200", "400", "401", "403", "429", "500"], "post": ["200", "400", "401", "403", "404", "409", "413", "415", "422", "429", "500"]},
    "/services/{service_id}": {"delete": ["204", "400", "401", "403", "404", "412", "428"], "patch": ["200", "400", "401", "403", "404", "412", "413", "415", "422", "429", "500"], "put": ["200", "400", "401", "403", "404", "409", "412", "413", "415", "422", "428", "429", "500"]},
    "/services/{service_id}/code-bindings": {"get": ["200"], "post": ["200"]},
    "/services/{service_id}/repository": {"delete": ["204", "404", "409", "412", "428"], "get": ["200", "404"], "post": ["200", "409", "422"]},
    "/specifications": {"get": ["200", "400", "401", "403", "429"], "post": ["200", "400", "401", "403", "404", "409", "413", "415", "422", "429", "500"]},
    "/specifications/{specification_id}": {"delete": ["204", "400", "401", "403", "404", "409", "412", "428"], "put": ["200", "400", "401", "403", "404", "409", "412", "413", "415", "422", "428", "429", "500"]},
    "/specifications/{specification_id}/code-binding": {"delete": ["204", "404", "409", "412", "428"], "get": ["200", "404"], "put": ["200", "404", "409", "412", "422", "428"]},
    "/specifications/{specification_id}/revisions": {"get": ["200", "400", "401", "403", "404", "429", "500"]},
    "/specifications/{specification_id}/revisions/{version}": {"get": ["200", "400", "401", "403", "404", "429", "500"]},
    "/specifications/{specification_id}/revisions/{version}/restore": {"post": ["200", "400", "401", "403", "404", "409", "412", "428", "429", "500"]},
    "/specifications/{specification_id}/sync": {"post": ["200", "404", "409", "502"]},
    "/tags": {"get": ["200", "400", "401", "403", "429"], "post": ["200", "400", "401", "403", "409", "413", "415", "422", "429", "500"]},
    "/tags/{tag_id}": {"delete": ["204", "400", "401", "403", "404", "409"], "put": ["200", "400", "401", "403", "404", "413", "415", "422"]},
    "/workspaces": {"get": ["200", "401", "429", "500"], "post": ["200", "400", "401", "403", "413", "415", "422", "429", "500"]},
    "/workspaces/{workspace_id}": {"delete": ["204", "400", "401", "403", "404"], "put": ["200", "400", "401", "403", "404", "413", "415", "422"]}
  },
  "parameters": {
    "/groups": {"get": ["limit", "offset"], "post": ["Idempotency-Key"]},
    "/tags": {"get": ["limit", "offset"], "post": ["Idempotency-Key"]},
    "/members": {"get": ["limit", "offset"]},
    "/services": {"get": ["cursor", "includeArchived", "limit", "offset", "q", "tagId"], "post": ["Idempotency-Key"]},
    "/groups/{group_id}": {"delete": ["group_id"], "put": ["group_id"]},
    "/services/{service_id}": {"delete": ["If-Match", "service_id"], "patch": ["service_id"], "put": ["If-Match", "service_id"]},
    "/code-sources": {"post": ["Idempotency-Key"]},
    "/code-sources/{source_id}": {"delete": ["If-Match", "source_id"], "put": ["If-Match", "source_id"]},
    "/services/{service_id}/code-bindings": {"post": ["Idempotency-Key", "service_id"]},
    "/services/{service_id}/repository": {"delete": ["If-Match", "service_id"], "get": ["service_id"], "post": ["Idempotency-Key", "service_id"]},
    "/code-bindings/{binding_id}": {"delete": ["If-Match", "binding_id"], "put": ["If-Match", "binding_id"]},
    "/members/{member_actor_id}": {"delete": ["member_actor_id"], "put": ["member_actor_id"]},
    "/invitations/{invitation_id}": {"delete": ["invitation_id"]},
    "/backups/{file_name}/restore": {"post": ["file_name"]},
    "/specifications": {"get": ["limit", "offset"], "post": ["Idempotency-Key"]},
    "/specifications/{specification_id}": {"delete": ["If-Match", "specification_id"], "put": ["If-Match", "specification_id"]},
    "/specifications/{specification_id}/code-binding": {"delete": ["If-Match", "specification_id"], "get": ["specification_id"], "put": ["If-Match", "specification_id"]},
    "/tags/{tag_id}": {"delete": ["tag_id"], "put": ["tag_id"]},
    "/workspaces/{workspace_id}": {"delete": ["workspace_id"], "put": ["workspace_id"]}
    ,"/specifications/{specification_id}/revisions": {"get": ["limit", "offset", "specification_id"]}
    ,"/specifications/{specification_id}/revisions/{version}": {"get": ["specification_id", "version"]}
    ,"/specifications/{specification_id}/revisions/{version}/restore": {"post": ["If-Match", "specification_id", "version"]}
    ,"/specifications/{specification_id}/sync": {"post": ["specification_id"]}
  },
  "responseHeaders": {
    "/services": {"post": {"200": ["ETag"]}},
    "/code-sources": {"post": {"200": ["ETag"]}},
    "/code-sources/{source_id}": {"put": {"200": ["ETag"]}},
    "/services/{service_id}": {"patch": {"200": ["ETag"]}, "put": {"200": ["ETag"]}},
    "/services/{service_id}/code-bindings": {"post": {"200": ["ETag"]}},
    "/services/{service_id}/repository": {"get": {"200": ["ETag"]}, "post": {"200": ["ETag"]}},
    "/code-bindings/{binding_id}": {"put": {"200": ["ETag"]}},
    "/specifications": {"post": {"200": ["ETag"]}},
    "/specifications/{specification_id}": {"put": {"200": ["ETag"]}}
    ,"/specifications/{specification_id}/code-binding": {"get": {"200": ["ETag"]}, "put": {"200": ["ETag"]}}
    ,"/specifications/{specification_id}/sync": {"post": {"200": ["ETag"]}}
  },
  "schemas": {
    "ErrorResponse": {
      "required": ["code", "messageKey", "messageParams", "version"],
      "properties": ["code", "messageKey", "messageParams", "version"]
    },
    "WorkspaceAccessResponse": {
      "required": ["actorId", "role", "tenantId", "workspaceId"],
      "properties": ["actorId", "role", "tenantId", "workspaceId"]
    },
    "CreateGroupRequest": {
      "required": ["id", "name"],
      "properties": ["id", "name", "parentId", "position"]
    },
    "UpdateGroupRequest": {
      "required": ["name"],
      "properties": ["name", "parentId", "position"]
    },
    "GroupOrderItem": {
      "required": ["id", "position"],
      "properties": ["id", "parentId", "position"]
    },
    "ReorderGroupsRequest": {
      "required": ["items"],
      "properties": ["items"]
    },
    "CreateInvitationRequest": {
      "required": ["email", "role"],
      "properties": ["email", "role"]
    },
    "AcceptInvitationRequest": {
      "required": ["token"],
      "properties": ["token"]
    },
    "InvitationResponse": {
      "required": ["createdAt", "createdBy", "email", "expiresAt", "id", "role"],
      "properties": ["acceptedAt", "createdAt", "createdBy", "email", "expiresAt", "id", "revokedAt", "role"]
    },
    "CreatedInvitationResponse": {
      "required": ["createdAt", "createdBy", "email", "expiresAt", "id", "role", "token"],
      "properties": ["acceptedAt", "createdAt", "createdBy", "email", "expiresAt", "id", "revokedAt", "role", "token"]
    },
    "AcceptedInvitationResponse": {
      "required": ["actorId", "role", "workspaceId"],
      "properties": ["actorId", "role", "workspaceId"]
    },
    "CreateServiceRequest": {
      "required": ["id", "name", "slug"],
      "properties": ["description", "groupId", "id", "name", "slug", "tagIds"]
    },
    "UpdateTagRequest": {
      "required": ["color", "name"],
      "properties": ["color", "name"]
    },
    "CreateSpecificationRequest": {
      "required": ["content", "id", "serviceId", "title"],
      "properties": ["content", "id", "serviceId", "source", "title"]
    },
    "CreateSpecificationSourceRequest": {
      "required": ["path", "refKind", "refName"],
      "properties": ["path", "refKind", "refName"]
    },
    "SpecificationResponse": {
      "required": ["content", "contentHash", "etag", "id", "kind", "serviceId", "tenantId", "title", "updatedAt", "version", "workspaceId"],
      "properties": ["content", "contentHash", "etag", "id", "kind", "serviceId", "tenantId", "title", "updatedAt", "version", "workspaceId"]
    },
    "SpecificationSyncResponse": {
      "required": ["changed", "contentHash", "manifestHash", "providerVersion", "resolvedCommit", "snapshotId", "specification", "syncedAt"],
      "properties": ["changed", "contentHash", "manifestHash", "providerVersion", "resolvedCommit", "snapshotId", "specification", "syncedAt"]
    },
    "ServicePageResponse": {
      "required": ["items", "limit", "offset", "query", "tagIds", "total"],
      "properties": ["items", "limit", "nextCursor", "nextOffset", "offset", "query", "tagIds", "total"]
    },
    "GroupPageResponse": {
      "required": ["items", "limit", "offset", "total"],
      "properties": ["items", "limit", "nextOffset", "offset", "total"]
    },
    "TagPageResponse": {
      "required": ["items", "limit", "offset", "total"],
      "properties": ["items", "limit", "nextOffset", "offset", "total"]
    },
    "SpecificationPageResponse": {
      "required": ["items", "limit", "offset", "total"],
      "properties": ["items", "limit", "nextOffset", "offset", "total"]
    },
    "SpecificationRevisionPageResponse": {
      "required": ["items", "limit", "offset", "total"],
      "properties": ["items", "limit", "nextOffset", "offset", "total"]
    },
    "SpecificationRevisionResponse": {
      "required": ["content", "contentHash", "createdAt", "createdBy", "specificationId", "version"],
      "properties": ["content", "contentHash", "createdAt", "createdBy", "specificationId", "version"]
    },
    "SetMemberRoleRequest": {
      "required": ["role"],
      "properties": ["role"]
    },
    "SetServiceArchivedRequest": {
      "required": ["archived"],
      "properties": ["archived"]
    },
    "ServiceResponse": {
      "required": ["archived", "description", "etag", "id", "name", "slug", "tagIds", "tenantId", "updatedAt", "workspaceId"],
      "properties": ["archived", "description", "etag", "groupId", "id", "name", "slug", "tagIds", "tenantId", "updatedAt", "workspaceId"]
    },
    "CodeSourcePageResponse": {
      "required": ["items"],
      "properties": ["items"]
    },
    "CodeSourceResponse": {
      "required": ["archived", "canonicalKey", "createdAt", "displayName", "etag", "executionScope", "id", "provider", "rootLocator", "sourceType", "tenantId", "updatedAt", "workspaceId"],
      "properties": ["archived", "canonicalKey", "createdAt", "displayName", "etag", "executionScope", "id", "provider", "rootLocator", "sourceType", "tenantId", "updatedAt", "workspaceId"]
    },
    "CreateCodeSourceRequest": {
      "required": ["canonicalKey", "displayName", "executionScope", "id", "provider", "rootLocator", "sourceType"],
      "properties": ["canonicalKey", "displayName", "executionScope", "id", "provider", "rootLocator", "sourceType"]
    },
    "UpdateCodeSourceRequest": {
      "required": ["canonicalKey", "displayName", "executionScope", "provider", "rootLocator", "sourceType"],
      "properties": ["canonicalKey", "displayName", "executionScope", "provider", "rootLocator", "sourceType"]
    },
    "ServiceCodeBindingPageResponse": {
      "required": ["items"],
      "properties": ["items"]
    },
    "ServiceCodeBindingResponse": {
      "required": ["createdAt", "entityKind", "etag", "id", "path", "revisionKind", "role", "serviceId", "sourceId", "tenantId", "updatedAt", "workspaceId"],
      "properties": ["createdAt", "entityKind", "etag", "id", "path", "revision", "revisionKind", "role", "serviceId", "sourceId", "tenantId", "updatedAt", "workspaceId"]
    },
    "CreateCodeBindingRequest": {
      "required": ["entityKind", "id", "revisionKind", "role", "sourceId"],
      "properties": ["entityKind", "id", "path", "revision", "revisionKind", "role", "sourceId"]
    },
    "UpdateCodeBindingRequest": {
      "required": ["entityKind", "revisionKind", "role"],
      "properties": ["entityKind", "path", "revision", "revisionKind", "role"]
    },
    "RepositorySummaryResponse": {
      "required": ["canonicalUrl", "displayName", "id", "provider"],
      "properties": ["canonicalUrl", "displayName", "id", "provider"]
    },
    "ServiceRepositoryResponse": {
      "required": ["createdAt", "etag", "id", "repository", "updatedAt"],
      "properties": ["createdAt", "etag", "id", "repository", "updatedAt"]
    },
    "LinkServiceRepositoryRequest": {
      "required": ["repositoryUrl"],
      "properties": ["repositoryUrl"]
    },
    "SpecificationCodeBindingResponse": {
      "required": ["createdAt", "etag", "id", "path", "refKind", "refName", "repository", "specificationId", "updatedAt"],
      "properties": ["createdAt", "etag", "id", "path", "refKind", "refName", "repository", "specificationId", "updatedAt"]
    },
    "SetSpecificationCodeBindingRequest": {
      "required": ["refKind", "refName"],
      "properties": ["path", "refKind", "refName"]
    },
    "UpdateServiceRequest": {
      "required": ["name", "slug"],
      "properties": ["description", "groupId", "name", "slug", "tagIds"]
    },
    "ReadyResponse": {
      "required": ["schemaVersion", "status"],
      "properties": ["schemaVersion", "status"]
    },
    "UpdateSpecificationRequest": {
      "required": ["content", "title"],
      "properties": ["content", "title"]
    },
    "WorkspaceMemberResponse": {
      "required": ["actorId", "createdAt", "role"],
      "properties": ["actorId", "createdAt", "revokedAt", "role"]
    },
    "WorkspaceMemberPageResponse": {
      "required": ["items", "limit", "offset", "total"],
      "properties": ["items", "limit", "nextOffset", "offset", "total"]
    },
    "CreateWorkspaceRequest": {
      "required": ["name"],
      "properties": ["name"]
    },
    "UpdateWorkspaceRequest": {
      "required": ["name"],
      "properties": ["name"]
    },
    "WorkspaceResponse": {
      "required": ["createdAt", "id", "name", "role", "slug", "tenantId"],
      "properties": ["createdAt", "id", "name", "role", "slug", "tenantId"]
    },
    "WorkspaceListResponse": {
      "required": ["items"],
      "properties": ["items"]
    },
    "BackupResponse": {
      "required": ["bytes", "fileName"],
      "properties": ["bytes", "fileName", "sha256"]
    }
  }
}
