{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "specX",
  "version": "0.1.0",
  "identifier": "com.specx.desktop",
  "build": {
    "frontendDist": "../apps/desktop/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --dir apps/desktop dev",
    "beforeBuildCommand": "pnpm --dir apps/desktop build"
  },
  "app": {
    "windows": [
      {
        "title": "specX",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        },
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
